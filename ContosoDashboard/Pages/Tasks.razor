@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.IO
@attribute [Authorize]
@inject ITaskService TaskService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Tasks - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>My Tasks</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> New Task
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>Status</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">All</option>
                <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                <option value="@Models.TaskStatus.InProgress">In Progress</option>
                <option value="@Models.TaskStatus.Completed">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>Priority</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">All</option>
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
                <option value="@TaskPriority.Critical">Critical</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">No tasks found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Project</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@task.Title</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@task.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                                    <option value="@Models.TaskStatus.InProgress">In Progress</option>
                                    <option value="@Models.TaskStatus.Completed">Completed</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No due date</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@task.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showTaskDetailsModal && selectedTaskItem != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content shadow border-0">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold"><i class="bi bi-list-task me-2 text-primary"></i>Detalles de Tarea: @selectedTaskItem.Title</h5>
                        <button type="button" class="btn-close" @onclick="HideTaskDetailsModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label class="text-muted small d-block">Descripción</label>
                                <p class="lead">@(selectedTaskItem.Description ?? "Sin descripción.")</p>
                            </div>
                            <div class="col-md-4 bg-light p-3 rounded border">
                                <div class="mb-2">
                                    <span class="fw-bold">Estado:</span> 
                                    <span class="badge bg-primary">@selectedTaskItem.Status</span>
                                </div>
                                <div class="mb-2">
                                    <span class="fw-bold">Prioridad:</span> 
                                    <span class="badge bg-@GetPriorityColor(selectedTaskItem.Priority)">@selectedTaskItem.Priority</span>
                                </div>
                                <div class="mb-2">
                                    <span class="fw-bold">Vencimiento:</span> 
                                    <span>@(selectedTaskItem.DueDate?.ToString("MMM dd, yyyy") ?? "Sin vencimiento")</span>
                                </div>
                                @if (selectedTaskItem.Project != null)
                                {
                                    <div>
                                        <span class="fw-bold">Proyecto:</span> 
                                        <span>@selectedTaskItem.Project.Name</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <hr />

                        <!-- Sección de Documentos -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-paperclip me-1 text-primary"></i>Documentos Adjuntos</h6>
                            <div class="d-flex align-items-center">
                                @if (isTaskUploading)
                                {
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                }
                                <InputFile @key="taskInputFileKey" OnChange="UploadTaskFile" class="form-control form-control-sm" style="max-width: 250px;" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(taskUploadError))
                        {
                            <div class="alert alert-danger py-1 mb-3 small">@taskUploadError</div>
                        }
                        @if (!string.IsNullOrEmpty(taskUploadSuccess))
                        {
                            <div class="alert alert-success py-1 mb-3 small">@taskUploadSuccess</div>
                        }

                        @if (taskDocuments == null || !taskDocuments.Any())
                        {
                            <p class="text-muted small py-2">No hay documentos adjuntos a esta tarea.</p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var doc in taskDocuments)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <i class="bi @GetFileIconClass(doc.FileName) me-2"></i>
                                            <span class="fw-semibold small">@doc.Title</span>
                                            <span class="text-muted small ms-2">(@FormatFileSize(doc.FileSize) - @doc.UploadedByUser?.DisplayName)</span>
                                        </div>
                                        <a href="/api/documents/download/@doc.DocumentId" class="btn btn-sm btn-outline-primary" target="_blank">
                                            <i class="bi bi-download"></i> Descargar
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="HideTaskDetailsModal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<TaskItem>? tasks;
    private string filterStatus = "";
    private string filterPriority = "";
    private int currentUserId = 0;

    // Task Details Modal
    private bool showTaskDetailsModal = false;
    private TaskItem? selectedTaskItem;
    private List<Document> taskDocuments = new List<Document>();
    private string taskUploadError = "";
    private string taskUploadSuccess = "";
    private bool isTaskUploading = false;
    private Guid taskInputFileKey = Guid.NewGuid();

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private void ShowCreateTaskModal()
    {
        // TODO: Implement modal dialog for creating tasks
    }

    private async Task ViewTaskDetails(int taskId)
    {
        if (tasks == null) return;

        selectedTaskItem = tasks.FirstOrDefault(t => t.TaskId == taskId);
        if (selectedTaskItem != null)
        {
            taskUploadError = "";
            taskUploadSuccess = "";
            showTaskDetailsModal = true;
            await LoadTaskDocuments();
        }
    }

    private void HideTaskDetailsModal()
    {
        showTaskDetailsModal = false;
        selectedTaskItem = null;
    }

    private async Task LoadTaskDocuments()
    {
        if (selectedTaskItem == null) return;
        
        try
        {
            var allDocs = await DocumentService.SearchDocumentsAsync("", currentUserId);
            taskDocuments = allDocs.Where(d => d.TaskId == selectedTaskItem.TaskId).ToList();
        }
        catch (Exception ex)
        {
            taskUploadError = $"Error al cargar documentos: {ex.Message}";
        }
    }

    private async Task UploadTaskFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedTaskItem == null) return;

        if (file.Size > 25 * 1024 * 1024)
        {
            taskUploadError = "El archivo excede el límite de 25 MB.";
            taskUploadSuccess = "";
            return;
        }

        isTaskUploading = true;
        taskUploadError = "";
        taskUploadSuccess = "";

        try
        {
            using var memoryStream = new MemoryStream();
            using (var uploadStream = file.OpenReadStream(26214400))
            {
                await uploadStream.CopyToAsync(memoryStream);
            }
            memoryStream.Position = 0;

            var title = Path.GetFileNameWithoutExtension(file.Name);

            var success = await DocumentService.UploadDocumentAsync(
                title,
                $"Documento adjuntado a la tarea '{selectedTaskItem.Title}'",
                "Project Documents",
                file.Name,
                file.ContentType,
                memoryStream,
                currentUserId,
                selectedTaskItem.ProjectId,
                "task",
                selectedTaskItem.TaskId
            );

            if (success)
            {
                taskUploadSuccess = "¡Documento adjuntado con éxito!";
                await LoadTaskDocuments();
                taskInputFileKey = Guid.NewGuid();
            }
            else
            {
                taskUploadError = "Error al subir el documento.";
            }
        }
        catch (Exception ex)
        {
            taskUploadError = $"Error de subida: {ex.Message}";
        }
        finally
        {
            isTaskUploading = false;
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB" };
        double dblSized = bytes;
        int i = 0;
        while (dblSized >= 1024 && i < suffix.Length - 1)
        {
            dblSized /= 1024;
            i++;
        }
        return $"{dblSized:F1} {suffix[i]}";
    }

    private string GetFileIconClass(string filename)
    {
        var ext = Path.GetExtension(filename).ToLower();
        return ext switch
        {
            ".pdf" => "bi-file-pdf text-danger",
            ".doc" or ".docx" => "bi-file-word text-primary",
            ".xls" or ".xlsx" => "bi-file-excel text-success",
            ".ppt" or ".pptx" => "bi-file-slides text-warning",
            ".jpg" or ".jpeg" or ".png" => "bi-file-image text-info",
            ".txt" => "bi-file-text text-secondary",
            _ => "bi-file-earmark text-muted"
        };
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}
